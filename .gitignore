# Independent application repositories (not submodules).
/web/
/api/
/mobile/

# Machine-local runtimes, credentials, and agent state.
/.toolchains/
/.docker/
/.codex/
/.aws/
/.ssh/
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key

# Downloaded reference data, imports, and backups; keep authored guidance.
/resources/*
!/resources/inaturalist/
/resources/inaturalist/*
!/resources/inaturalist/README.md
/backups/
*.dump
*.sql.gz

# Local output and scratch files.
/log/
/logs/
/tmp/
*.log
/foo.txt
.DS_Store
__pycache__/
*.py[cod]
node_modules/
